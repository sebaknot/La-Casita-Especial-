# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic — powers the command bar (POST /api/command)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the parsing model and its refusal fallback
# COMMAND_MODEL=claude-opus-5-5
# COMMAND_FALLBACK_MODEL=claude-opus-4-8
