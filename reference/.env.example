# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The single allowed user (email/password auth, allowlist of one)
ALLOWED_EMAIL=you@example.com

# Anthropic — powers the command bar parser (POST /api/command)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the parsing model (defaults to claude-sonnet-4-6)
# COMMAND_MODEL=claude-sonnet-4-6
